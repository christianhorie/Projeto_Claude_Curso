# ==================================================================
# NITRO · DEIXA COMIGO BEBIDAS — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` está no .gitignore e NUNCA deve ser versionado ou colado
# em chat, e-mail ou ticket. As chaves ficam apenas no servidor —
# o browser jamais as recebe.
# ==================================================================

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadeia de fallback, em ordem de preferência. Se o primeiro modelo
# falhar por cota (429), indisponibilidade (5xx) ou não existir (404),
# o servidor tenta o próximo automaticamente.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.6-pro

# OpenWeatherMap — https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Porta do servidor local
PORT=4173
